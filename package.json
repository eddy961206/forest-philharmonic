{
  "name": "forest-philharmonic",
  "version": "1.0.0",
  "description": "숲속 동물 오케스트라가 3D 콘서트홀에서 클래식을 연주하는 힐링 웹 — spatial-audio animal orchestra in the browser",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/test.mjs",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:music": "node tools/run-python.mjs tools/build_music.py --fetch",
    "build:samples": "node tools/run-python.mjs tools/fetch_samples.py && node tools/run-python.mjs tools/fetch_percussion.py && node tools/run-python.mjs tools/analyze_samples.py",
    "build:repertoire": "node tools/run-python.mjs tools/build_repertoire.py",
    "check:repertoire": "node tools/run-python.mjs tools/build_repertoire.py --check",
    "check:motion": "node --import ./tests/helpers/register-three.mjs tools/qa/audit-playing-motion.mjs",
    "record:motion": "node tools/qa/record-playing-motion.mjs",
    "verify:motion": "node tools/qa/verify-motion.mjs",
    "verify:app": "node tools/qa/verify-app-flow.mjs",
    "verify:features": "node tools/qa/verify-features.mjs"
  }
}
